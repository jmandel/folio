{
  "name": "folio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "check:examples": "bun work/check-examples.ts",
    "check:hashes": "bun work/schema-hashes.ts --check",
    "gen": "bun packages/render/src/cli/gen.ts",
    "prose": "bun packages/render/src/cli/prose.ts",
    "check:corpus": "bun packages/render/src/cli/check.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p site/tsconfig.json",
    "nodes": "bun packages/sync/src/cli.ts",
    "agent": "bun packages/personal-agent/src/cli.ts",
    "gen-keys": "bun packages/core/scripts/gen-dev-keys.ts",
    "sign": "bun packages/render/src/cli/sign.ts",
    "site:data": "bun site/scripts/prepare-data.ts",
    "site:dev": "bun run site:data && cd site && bunx vite",
    "site:build": "bun run sign && bun site/scripts/prepare-data.ts && cd site && bunx vite build",
    "site:check": "bun site/scripts/screens.ts"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "5.6.3"
  }
}
