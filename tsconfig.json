{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/**/*.ts",
    "work/*.ts",
    "sources/**/*.d.ts"
  ],
  "exclude": [
    "runs",
    "corpus",
    "corpus-fresh",
    "build",
    "results",
    "node_modules",
    "packages/**/test/fixtures"
  ]
}
