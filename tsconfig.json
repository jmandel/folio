{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    "**/node_modules",
    "site",
    "build"
  ]
}
